# ========================================
# REQUIRED — bot won't start without these
# ========================================

# Postgres connection (auto-provided by Railway when you add Postgres service)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Claude API key — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-xxxx

# Your timezone — https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Asia/Amman


# ========================================
# TELEGRAM (recommended — easy to set up)
# ========================================

# Get from @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=


# ========================================
# WHATSAPP (optional — complex Meta setup)
# ========================================

# From Meta Developer → WhatsApp → System User → generate permanent token
WHATSAPP_ACCESS_TOKEN=

# From Meta Developer → WhatsApp → API Setup → "From" section
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# YOUR personal WhatsApp number (international format, no + or spaces)
# Used for outbound notifications like birthdays, follow-ups, EOD recap
WHATSAPP_TO_NUMBER=962790000000

# Pick any random string — used by Meta to verify the webhook belongs to you
WHATSAPP_VERIFY_TOKEN=mybot_webhook_2026

# From Meta Developer → Settings → Basic → App Secret
# Required for HMAC signature verification on incoming webhooks
META_APP_SECRET=


# ========================================
# OPTIONAL — reliability monitoring
# ========================================

# External dead-man's-switch (e.g. healthchecks.io). The bot pings this URL
# every 2 min; if pings stop (crash/outage), the service alerts you.
# Create a free check at https://healthchecks.io (period 2m, grace 2m).
HEALTHCHECK_URL=

# Internal DB self-check alerts are sent over WhatsApp to WHATSAPP_TO_NUMBER
# (configured above). No extra var needed — if that number is set, the bot
# texts you when the database becomes unreachable.


# ========================================
# OPTIONAL — voice notes
# ========================================

# OpenAI API key for Whisper transcription
# Get from https://platform.openai.com/api-keys
# Without this, voice notes will return "voice notes not configured"
OPENAI_API_KEY=


# ========================================
# OPTIONAL — Google Calendar sync
# ========================================

# Google Cloud Console → Credentials → OAuth Client ID (Web application)
# Redirect URI must be: https://your-bot.up.railway.app/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ========================================
# OPTIONAL — GitHub code queries
# ========================================

# Fine-grained personal access token with read access to your repo
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Repo to query, format: owner/repo (e.g. "torvalds/linux")
GITHUB_REPO=


# ========================================
# OPTIONAL — Thoughts idea graph
# ========================================

# Forward captured ideas (and new journal/memory notes) to the Thoughts service,
# which builds an auto-connected idea graph. Leave unset to disable forwarding.
# Capture triggers: an "idea:"/"thought:"/"#…" prefix, or the AI "idea" intent.
THOUGHTS_INGEST_URL=https://your-thoughts.up.railway.app
# Shared secret — must match THOUGHTS_INGEST_SECRET in the Thoughts service.
THOUGHTS_INGEST_SECRET=
# Only forward ideas from these chat ids (comma-separated). Defaults to your own
# number (WHATSAPP_TO_NUMBER) so strangers texting the bot can't inject content
# into your personal graph. Leave blank only for an intentionally open deployment.
THOUGHTS_ALLOWED_CHATS=


# ========================================
# OPTIONAL — chat-memory semantic recall
# ========================================

# Voyage AI API key — get from https://dash.voyageai.com
# Enables embedding chat messages (voyage-3-lite) so the bot can semantically
# recall older conversation history (e.g. "what was that thing about the
# factory guy?"). Fully optional and fully inert if unset — the feature is
# skipped silently, nothing else breaks.
VOYAGE_API_KEY=
